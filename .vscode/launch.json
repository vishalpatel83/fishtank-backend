{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "Debug Nest App",
            "args": [
                "start",
                "--debug",
                "--watch"
            ],
            "executable": "npm",
            "runtimeExecutable": "npm",
            "runtimeArgs": [
                "run-script"
            ],
            "sourceMaps": true,
            "restart": true,
            "protocol": "inspector",
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen"
        },
        {
            "type": "node",
            "request": "attach",
            "name": "Attach to Nest App",
            "port": 9229,
            "restart": true,
            "sourceMaps": true
        }
    ]
}